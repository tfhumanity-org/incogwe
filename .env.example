# Master key for field-level encryption at rest. 32 bytes, base64.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
DELETEWE_MASTER_KEY=

# Where the encrypted store lives.
DELETEWE_DB=./var/deletewe.sqlite

# Transport. "mock" (in-process mock brokers) or "dryrun" (render, never send).
# A live SMTP transport is deliberately NOT implemented in this repo. See docs/playbook.
DELETEWE_TRANSPORT=dryrun

# Live sending is additionally gated on an explicit attestation that a qualified
# lawyer has reviewed the request templates for the jurisdictions in use.
# DELETEWE_TEMPLATES_REVIEWED=
